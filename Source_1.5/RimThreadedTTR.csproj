<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Project file for building with the .NET SDK (dotnet build).
    The DLL shipped in 1.6/Assemblies was compiled on a machine without the SDK
    using the legacy framework compiler; that is why the source is C# 5 only:

    C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe
      /noconfig /nostdlib+ /langversion:5 /target:library /optimize+
      /out:..\1.6\Assemblies\RimThreadedTTR.dll
      /r:(RimWorld Managed dir)\mscorlib.dll;System.dll;System.Core.dll;netstandard.dll;
         Assembly-CSharp.dll;UnityEngine.CoreModule.dll;(Harmony)\0Harmony.dll
      *.cs
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- FastLoad 的源码用到 C# 7.x 语法（原来的 TTR 源码是 C# 5） -->
    <LangVersion>7.3</LangVersion>
    <!-- 合并版：FPS+ 的设置界面 + 单一 Mod 类 / 单一设置文件。
         不定义它就会退回「FPSPlusMod 作为独立 Mod 类」的旧结构。 -->
    <DefineConstants>$(DefineConstants);TTR_MERGED</DefineConstants>
    <OutputPath>..\1.6\Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Adjust to your RimWorld install -->
    <RimWorldManaged>/home/uitstalie/.local/share/Steam/steamapps/common/RimWorld/RimWorldLinux_Data/Managed</RimWorldManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
      <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
